# Example environment file: placeholders only, never commit a real .env.
# Only variables actually read by the code are listed. OKX settings are added with the exchange adapter (R17, R20).

# Legacy KuCoin public market-data endpoint (removed when the ccxt data source lands)
KUCOIN_API_URL=https://api.kucoin.com

# Application
TRADING_BOT_CONFIG=config/config.json
TRADING_BOT_LOG_LEVEL=INFO
TRADING_BOT_LOG_JSON=false

# Dashboard (loopback by default, debug only with 1)
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=5000
DASHBOARD_DEBUG=0
